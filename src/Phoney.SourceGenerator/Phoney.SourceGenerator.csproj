<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Roslyn loads generators into the compiler, which requires netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <DefineConstants>$(DefineConstants);PHONEY_GENERATOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phoney.SourceGenerator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The convention table is shared with the runtime so both paths choose the same values. -->
    <Compile Include="../Phoney/Generation/Shared/ConventionRules.cs" Link="Shared/ConventionRules.cs" />
    <!-- So are the generated collection shapes: one table decides which member types are collections and how they are converted. -->
    <Compile Include="../Phoney/Generation/Shared/MemberShapes.cs" Link="Shared/MemberShapes.cs" />
    <!-- And the rules for merging data annotations, so the reflection model and the generator read the same constraints. -->
    <Compile Include="../Phoney/Generation/Shared/ConstraintState.cs" Link="Shared/ConstraintState.cs" />
    <!-- And how a value of a member type is made, so both models dispatch the same way (ValueShapes.Symbols.cs reads the facts from symbols). -->
    <Compile Include="../Phoney/Generation/Shared/ValueShapes.cs" Link="Shared/ValueShapes.cs" />
    <!-- And which members a strict generator wants a source for, so the PHONEY004 warning names the members the exception would. -->
    <Compile Include="../Phoney/Generation/Shared/StrictCoverage.cs" Link="Shared/StrictCoverage.cs" />
  </ItemGroup>
</Project>
