<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Phoney</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Phoney</PackageId>
    <Description>Fast, easy and flexible fake data for .NET: 76 locales imported from faker.js, convention-based object population with interfaces and subtypes, fluent rules, deterministic seeds, TimeProvider support, and a source generator and analyzer for reflection-free, AOT-safe generation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- For [module: SkipLocalsInit] (AssemblyInfo.cs): stack buffers are written before they are read, so zeroing them is wasted work on hot paths. No unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WithCulture=false: otherwise MSBuild may read "bin" in "en.bin.br" as a culture and move the data into satellite assemblies. -->
    <EmbeddedResource Include="Resources/Locales/*.bin.br" LogicalName="Phoney.Locales.%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phoney.Tests" />
    <InternalsVisibleTo Include="Phoney.Benchmarks" />
    <InternalsVisibleTo Include="Phoney.Benchmarks.Comparison" />
    <!-- The add-on tests compare the reflection and generated models. -->
    <InternalsVisibleTo Include="Phoney.NodaTime.Tests" />
  </ItemGroup>

  <!-- Ship the source generator and analyzers inside the Phoney package so [FakeFor<T>] works with a single package reference; the code fixes sit next to them. -->
  <ItemGroup>
    <ProjectReference Include="../Phoney.SourceGenerator/Phoney.SourceGenerator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Phoney.CodeFixes/Phoney.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Phoney.SourceGenerator/bin/$(Configuration)/netstandard2.0/Phoney.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../Phoney.CodeFixes/bin/$(Configuration)/netstandard2.0/Phoney.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!--
    ReadyToRun: `dotnet pack -p:PackReadyToRun=true` (CI does) adds Phoney.dll precompiled per runtime under runtimes/<rid>/lib/<tfm>, next to the IL-only
    lib/<tfm> for every other platform. The host picks the copy for the machine's runtime (also in RID-less apps and `dotnet test`), so the first call
    skips most of the JIT work; the IL is the same, so the data is too. Native AOT and trimming compile from the IL.
  -->
  <PropertyGroup>
    <PackReadyToRun Condition="'$(PackReadyToRun)' == ''">false</PackReadyToRun>
    <!-- The platforms most development machines and CI agents run on; others use the IL in lib/<tfm> as before. -->
    <ReadyToRunPackRuntimes>win-x64;linux-x64;linux-arm64;osx-arm64</ReadyToRunPackRuntimes>
    <RuntimeIdentifiers Condition="'$(PackReadyToRun)' == 'true'">$(ReadyToRunPackRuntimes)</RuntimeIdentifiers>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddReadyToRunAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="AddReadyToRunAssemblies" Condition="'$(PackReadyToRun)' == 'true'">
    <ItemGroup>
      <_ReadyToRunRuntime Include="$(ReadyToRunPackRuntimes)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="TargetFramework=$(TargetFramework);RuntimeIdentifier=%(_ReadyToRunRuntime.Identity);SelfContained=false;PublishReadyToRun=true;PublishDir=$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)r2r/$(TargetFramework)/%(_ReadyToRunRuntime.Identity)/" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(BaseIntermediateOutputPath)r2r/$(TargetFramework)/%(_ReadyToRunRuntime.Identity)/$(AssemblyName).dll" PackagePath="runtimes/%(_ReadyToRunRuntime.Identity)/lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
