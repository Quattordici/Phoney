<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Phoney.MSTest</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not IsAotCompatible ([FakeData] reads test parameters with reflection by design), but the analyzers still flag reflection that is added unannounced. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsPackable>true</IsPackable>
    <PackageId>Phoney.MSTest</PackageId>
    <Description>Phoney fake data for MSTest tests: [FakeData] fills test method parameters, constructor parameters and properties with realistic, reproducible values that agree with each other.</Description>
    <PackageTags>$(PackageTags);mstest;autodata;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phoney.MSTest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets=none: installing only Phoney.MSTest still brings Phoney's [FakeFor<T>] source generator. -->
    <ProjectReference Include="../Phoney/Phoney.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
