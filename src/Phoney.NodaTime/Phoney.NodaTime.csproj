<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Phoney.NodaTime</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Phoney.NodaTime</PackageId>
    <Description>NodaTime for Phoney fake data: faker.Noda() generates Instant, LocalDate, ZonedDateTime and more relative to the reference date, and generated objects get NodaTime members that follow the name conventions (CreatedAt, BirthDate…).</Description>
    <PackageTags>$(PackageTags);nodatime;time</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets=none: installing only this package still brings Phoney's [FakeFor<T>] source generator. -->
    <ProjectReference Include="../Phoney/Phoney.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
