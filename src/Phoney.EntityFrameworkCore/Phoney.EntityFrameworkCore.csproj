<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Phoney.EntityFrameworkCore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Phoney.EntityFrameworkCore</PackageId>
    <Description>Seed EF Core models with Phoney fake data: modelBuilder.Entity&lt;T&gt;().HasFakeData(50) generates realistic, reproducible HasData seed rows with valid keys, linked foreign keys and no navigation values.</Description>
    <PackageTags>$(PackageTags);efcore;entityframeworkcore;seeding;hasdata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets=none: installing only this package still brings Phoney's [FakeFor<T>] source generator. -->
    <ProjectReference Include="../Phoney/Phoney.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
