<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>

    <Authors>Mattias Sundström</Authors>
    <Copyright>Copyright © Mattias Sundström</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Quattordici/Phoney</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Quattordici/Phoney</RepositoryUrl>
    <PackageTags>fake;faker;phony;fakerjs;test-data;mock;bogus;seed;generator</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>phoney-icon-128.png</PackageIcon>
  </PropertyGroup>
  <!-- Items are evaluated after all properties, so IsPackable here already sees the value set in the project file. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)images/phoney-icon-128.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <_RepoRelativeDir>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</_RepoRelativeDir>
  </PropertyGroup>
  <!-- SonarQube Cloud analyses everything under tests/ as test code: it doesn't recognise TUnit projects (or the AOT smoke app) by their references. -->
  <PropertyGroup Condition="$(_RepoRelativeDir.StartsWith('tests'))">
    <SonarQubeTestProject>true</SonarQubeTestProject>
  </PropertyGroup>
  <!-- tools/, benchmarks/ and samples/ are outside the analysis (sonar.exclusions in ci.yml). Excluding their projects too keeps the scanner's
       analyzers out of their build, so their findings don't show up as warning annotations on every CI run. -->
  <PropertyGroup Condition="$(_RepoRelativeDir.StartsWith('tools')) Or $(_RepoRelativeDir.StartsWith('benchmarks')) Or $(_RepoRelativeDir.StartsWith('samples'))">
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
