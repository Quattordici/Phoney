<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>

    <Authors>Mattias Sundström</Authors>
    <Copyright>Copyright © Mattias Sundström</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Quattordici/Phoney</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Quattordici/Phoney</RepositoryUrl>
    <PackageTags>fake;faker;phony;fakerjs;test-data;mock;bogus;seed;generator</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>phoney-icon-128.png</PackageIcon>
  </PropertyGroup>
  <!--
    The supported .NET releases, named once: every LTS release Microsoft still supports plus every stable release after the oldest of them.
    The weekly .NET support check (tools/Phoney.DotNetSupport, .github/workflows/dotnet-support.yml) fails when Microsoft's release index says
    otherwise; TargetFrameworkTests then point at what follows it (global.json, the workflows, the README).
  -->
  <PropertyGroup>
    <PhoneyTargetFrameworks>net10.0;net11.0</PhoneyTargetFrameworks>
    <!-- Apps, tools and benchmarks run on the newest. -->
    <PhoneyAppTargetFramework>net11.0</PhoneyAppTargetFramework>
    <!-- Tests run on the newest locally, where only the SDK's runtime is required; CI installs every runtime and tests every target. -->
    <PhoneyTestTargetFrameworks>$(PhoneyAppTargetFramework)</PhoneyTestTargetFrameworks>
    <PhoneyTestTargetFrameworks Condition="'$(GITHUB_ACTIONS)' == 'true'">$(PhoneyTargetFrameworks)</PhoneyTestTargetFrameworks>
  </PropertyGroup>
  <!-- Items are evaluated after all properties, so IsPackable here already sees the value set in the project file. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)images/phoney-icon-128.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <!-- SonarQube Cloud analyses everything under tests/ as test code: it doesn't recognise TUnit projects (or the AOT smoke app) by their references. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('tests'))">
    <SonarQubeTestProject>true</SonarQubeTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
