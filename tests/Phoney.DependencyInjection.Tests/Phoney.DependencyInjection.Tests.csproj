<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every supported target in CI, the newest locally (Directory.Build.props). -->
    <TargetFrameworks>$(PhoneyTestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney.DependencyInjection/Phoney.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/Phoney.SourceGenerator/Phoney.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shop model the docs' examples (Docs/*Examples.cs, checked by DocExampleTests) are written against. -->
    <Compile Include="../Shared/DocShop.cs" Link="Docs/DocShop.cs" />
  </ItemGroup>
</Project>
