<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every supported target in CI, the newest locally (Directory.Build.props). -->
    <TargetFrameworks>$(PhoneyTestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup Condition="'$(TestAgainstFloors)' == 'true'">
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney.EntityFrameworkCore/Phoney.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/Phoney.SourceGenerator/Phoney.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
