<Project Sdk="Microsoft.NET.Sdk">
  <!-- Published with Native AOT in CI: proves the source-generated path needs no reflection and is warning-free. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PhoneyAppTargetFramework)</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- Every publish lands where CI and the docs run it, so a local run never picks up an older binary. -->
    <PublishDir>$(MSBuildThisFileDirectory)../../artifacts/aot/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney/Phoney.csproj" />
    <ProjectReference Include="../../src/Phoney.DependencyInjection/Phoney.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/Phoney.NodaTime/Phoney.NodaTime.csproj" />
    <ProjectReference Include="../../src/Phoney.SourceGenerator/Phoney.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
