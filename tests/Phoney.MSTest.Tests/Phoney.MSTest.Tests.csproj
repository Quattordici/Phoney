<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CI installs the .NET 8 runtime and tests both targets; locally only the SDK's runtime is required. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GITHUB_ACTIONS)' == 'true'">net10.0;net8.0</TargetFrameworks>
    <!-- MSTest's own Microsoft.Testing.Platform runner, which is what `dotnet test` uses here (global.json). -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
    <!-- Test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney.MSTest/Phoney.MSTest.csproj" />
  </ItemGroup>
</Project>
