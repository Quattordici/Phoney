<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every supported target in CI, the newest locally (Directory.Build.props). -->
    <TargetFrameworks>$(PhoneyTestTargetFrameworks)</TargetFrameworks>
    <!-- MSTest's own Microsoft.Testing.Platform runner, which is what `dotnet test` uses here (global.json). -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
    <!-- Test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney.MSTest/Phoney.MSTest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shop model the docs' examples (Docs/*Examples.cs, checked by DocExampleTests) are written against. -->
    <Compile Include="../Shared/DocShop.cs" Link="Docs/DocShop.cs" />
  </ItemGroup>
</Project>
