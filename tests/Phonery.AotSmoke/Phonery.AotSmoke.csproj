<Project Sdk="Microsoft.NET.Sdk">
  <!-- Published with Native AOT in CI: proves the source-generated path needs no reflection and is warning-free. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phonery/Phonery.csproj" />
    <ProjectReference Include="../../src/Phonery.SourceGenerator/Phonery.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
