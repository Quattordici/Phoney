<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every supported target in CI, the newest locally (Directory.Build.props). -->
    <TargetFrameworks>$(PhoneyTestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <!-- Not with the floors: the oldest frameworks run on an older Microsoft.Testing.Platform. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Condition="'$(TestAgainstFloors)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney.Xunit/Phoney.Xunit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shop model the docs' examples (Docs/*Examples.cs, checked by DocExampleTests) are written against. -->
    <Compile Include="../Shared/DocShop.cs" Link="Docs/DocShop.cs" />
  </ItemGroup>
</Project>
