<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CI installs the .NET 8 runtime and tests both targets; locally only the SDK's runtime is required. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GITHUB_ACTIONS)' == 'true'">net10.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <!-- Not with the floors: the oldest frameworks run on an older Microsoft.Testing.Platform. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Condition="'$(TestAgainstFloors)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney.Xunit/Phoney.Xunit.csproj" />
  </ItemGroup>
</Project>
