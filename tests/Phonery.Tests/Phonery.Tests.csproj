<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CI installs the .NET 8 runtime and tests both targets; locally only the SDK's runtime is required. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GITHUB_ACTIONS)' == 'true'">net10.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- xUnit test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phonery/Phonery.csproj" />
    <ProjectReference Include="../../src/Phonery.SourceGenerator/Phonery.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
