<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every supported target in CI, the newest locally (Directory.Build.props). -->
    <TargetFrameworks>$(PhoneyTestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Test classes and methods are documented by their names. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- The P/Invoke marshalling that [LibraryImport] generates (CpuTime) is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TUnit" />
    <!-- The README's TimeProvider example (tests/Phoney.Tests/Docs) uses FakeTimeProvider. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phoney/Phoney.csproj" />
    <ProjectReference Include="../../src/Phoney.SourceGenerator/Phoney.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- One table of member types for both models: this project reads them through its own model, the other one through the other. -->
    <Compile Include="../Shared/ValueShapeCases.cs" Link="Shared/ValueShapeCases.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The support rule of the scheduled .NET support check, tested here against fixtures of Microsoft's release index. -->
    <Compile Include="../../tools/Phoney.DotNetSupport/SupportedReleases.cs" Link="Repository/SupportedReleases.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shop model the docs' examples (Docs/*Examples.cs, checked by DocExampleTests) are written against. -->
    <Compile Include="../Shared/DocShop.cs" Link="Docs/DocShop.cs" />
  </ItemGroup>
</Project>
